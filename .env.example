# Copy to .env next to manage.py. On cPanel use the production values below;
# for local development set DJANGO_DEBUG=1 and DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# A long random string: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
# The API's own address, without https://
DJANGO_ALLOWED_HOSTS=api.example.com
# The website's address (where the frontend lives), with https://
CORS_ORIGINS=https://example.com,https://www.example.com
# The API's address with https://, so the booth login works
CSRF_TRUSTED_ORIGINS=https://api.example.com
# 1 = Django serves uploaded posters and photos from media/
SERVE_MEDIA=1

# The Movie Database read access token (free, non-commercial): themoviedb.org > Settings > API
TMDB_TOKEN=
